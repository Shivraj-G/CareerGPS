# AI Service environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file with API keys.

# Internal auth token — must match INTERNAL_SERVICE_TOKEN in backend/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_64_HEX_CHARS

PORT=8000

# LLM provider: gemini | groq | none
LLM_PROVIDER=gemini
# Fallback provider (used when the primary fails or rate-limits)
LLM_FALLBACK_PROVIDER=groq

# Google Gemini API key (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional: override the default model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Groq API key (required if LLM_PROVIDER=groq or LLM_FALLBACK_PROVIDER=groq)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Optional: override the default model
# GROQ_MODEL=llama-3.3-70b-versatile

# Set to 'production' in production deployments
# NODE_ENV=production

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
