# Ingestion Worker environment variables
# Copy this file to .env and fill in values from the backend admin API.
# NEVER commit the real .env file with tokens.

# Backend URL (no trailing slash)
BACKEND_URL=http://localhost:5000

# Must match INTERNAL_SERVICE_TOKEN in backend/.env
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_64_HEX_CHARS

# These UUIDs are created by calling POST /api/v1/admin/sources and POST /api/v1/admin/ingestion/runs
# via the admin API before running the worker. They MUST be real UUIDs from the backend.
INGESTION_SOURCE_ID=REPLACE_WITH_UUID_FROM_BACKEND
INGESTION_RUN_ID=REPLACE_WITH_UUID_FROM_BACKEND

# The source URL to fetch and ingest
SOURCE_URL=https://www.goa.gov.in/citizen/recruitment/

# Extraction metadata version label
EXTRACTION_VERSION=phase8-v1

# HTTP timeout for fetching source pages (ms)
REQUEST_TIMEOUT_MS=15000
