# CareerGPS multi-source ingestion worker v2
# Uses only source records already approved by a CareerGPS admin.
BACKEND_URL=http://localhost:5000
# Must exactly match INTERNAL_SERVICE_TOKEN in backend/.env
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_64_HEX_CHARS

# Registry mode loads ALL approved sources from the backend, creates an ingestion run
# per source, and sends extracted candidates for review. No source/run UUIDs are needed.
INGESTION_MODE=registry

# Optional: limit to one approved source UUID; leave blank to process all matching approved sources.
# Verified official Goa recruitment source ID: c5f688a8-4fdd-4f8e-b43c-47f63f22707c (Goa Online Recruitment System, https://cbes.goa.gov.in/advertisement)
INGESTION_SOURCE_ID=
# Optional source_type filters, matched against registered source_type values. Examples:
# government_recruitment,private_careers,internship_board,apprenticeship,graduate_programme
# Leave blank to process all approved source types.
SOURCE_TYPES=

# Safety and polite crawling limits
REQUEST_TIMEOUT_MS=20000
MAX_RESPONSE_BYTES=5000000
MAX_SOURCES_PER_RUN=100
MAX_PAGES_PER_SOURCE=30
MAX_CANDIDATES_PER_SOURCE=100
MAX_CRAWL_DEPTH=2
MIN_REQUEST_DELAY_MS=1000
EXTRACTION_VERSION=multi-source-v2
DRY_RUN=false

# Legacy single-URL mode (only used when INGESTION_MODE=legacy).
# This mode requires existing approved SOURCE_ID and active RUN_ID values.
# INGESTION_SOURCE_ID=xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx
# INGESTION_RUN_ID=xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx
# SOURCE_URL=https://public.example.org/careers
# SOURCE_TYPE=private_careers
# SOURCE_ORGANIZATION=Example Company
# SOURCE_ACCESS_NOTES={"worker":{"max_pages":20,"max_candidates":50,"max_depth":2}}
