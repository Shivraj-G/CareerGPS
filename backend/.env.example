# Backend environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file with secrets.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/goa_career_intelligence

# CORS — set to your frontend URL (comma-separated origins are NOT supported; use a single origin)
CORS_ORIGIN=http://localhost:5173

# Logging level: fatal | error | warn | info | debug
LOG_LEVEL=info

# JWT — must be at least 32 random characters; generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_64_HEX_CHARS
JWT_ACCESS_EXPIRES_IN=6h

# AI service (optional — the backend degrades gracefully when absent)
AI_SERVICE_URL=http://localhost:8000

# Shared secret between backend and internal services (optional but strongly recommended in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_64_HEX_CHARS
