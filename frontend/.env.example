# Frontend Vite environment variables
# Copy this file to .env and adjust for your deployment.
# All variables MUST start with VITE_ to be exposed to the browser.
# NEVER put secrets (database passwords, API keys, JWT secrets) here.

# Backend origin (no /api/v1 suffix; the client appends that prefix exactly once)
# Development:
VITE_API_BASE_URL=http://localhost:5000
# Production: set this in Vercel's Production environment to the real backend origin.
# VITE_API_BASE_URL=https://api.your-real-backend-domain.com

# Your site's public URL (used for SEO / canonical links)
VITE_SITE_URL=http://localhost:5173
# Production:
# VITE_SITE_URL=https://yourdomain.com

# Optional: override the frontend API request timeout in milliseconds.
# Default is 60000 (60 s). Only change this if you have a specific reason.
# VITE_API_TIMEOUT_MS=60000
