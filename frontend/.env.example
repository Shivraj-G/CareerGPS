# Browser-visible Vite configuration only.
# Never put DATABASE_URL, JWT_SECRET, INTERNAL_SERVICE_TOKEN,
# AI service credentials, or private service URLs in Vite env vars.

# Local development — matches backend default PORT=5000 (see backend/.env)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Public site URL (used for canonical tags, OG meta, sitemap, structured data)
VITE_SITE_URL=http://localhost:5173

# Production example (set these in your deployment environment, e.g. Vercel)
#VITE_API_BASE_URL=https://your-deployed-backend-domain.com/api/v1
#VITE_SITE_URL=https://careergpsgoa.in
